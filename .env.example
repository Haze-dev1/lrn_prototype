# LRN environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Local development ---------------------------------------------------------------------
# Development containers run as this uid/gid so files they write into bind mounts (autogenerated
# migrations, for example) are owned by you. Find yours with: id -u ; id -g
HOST_UID=1000
HOST_GID=1000

# --- Runtime -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------------------
# Consumed by the postgres container to initialise the cluster.
POSTGRES_USER=lrn
POSTGRES_PASSWORD=change-me-in-every-environment
POSTGRES_DB=lrn
# Application connection string. The host is the Compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://lrn:change-me-in-every-environment@postgres:5432/lrn
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# --- Redis -------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Proxy / public origin ---------------------------------------------------------------
# Caddy site address. ':80' serves plain HTTP for local development; a hostname such as
# lrn.example.com makes Caddy provision and renew TLS automatically.
SITE_ADDRESS=:80
TLS_CONTACT_EMAIL=dev@localhost
# Host ports the proxy publishes. Use 8080/8443 locally to avoid privileged ports; 80/443 in
# production.
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443

# --- Web ---------------------------------------------------------------------------------
# Public origin users reach the product on; used for links in email and OAuth redirects.
PUBLIC_WEB_URL=http://localhost:8080
# Origins allowed to invoke Next.js Server Actions.
ALLOWED_ORIGINS=localhost:8080
# Internal address the web container uses to reach the API over the Docker network.
API_BASE_URL=http://api:8000
# Same-origin path the browser uses; the reverse proxy forwards it to the API.
NEXT_PUBLIC_API_PATH=/api

# --- Authentication ----------------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-32-byte-random-value-generated-per-environment
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth (optional until the Google sign-in path is enabled).
# Only the client ID is needed: the browser obtains the ID token and the server verifies its
# signature against Google's public keys, so no client secret is stored.
GOOGLE_CLIENT_ID=

# --- Rate limiting -------------------------------------------------------------------------
# Two buckets. Students overwhelmingly share campus NAT addresses, so the per-IP limit is
# generous and only stops crude floods; the tight per-account limit is what stops password
# guessing, and IP rotation cannot evade it.
LOGIN_RATE_LIMIT_PER_IP=60
LOGIN_RATE_LIMIT_PER_ACCOUNT=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_PER_IP=20
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# --- AI grading --------------------------------------------------------------------------
# 'fake' uses a deterministic in-process provider and makes no network calls; use it for local
# development and tests. Switch to 'groq' once a key is configured.
GRADING_PROVIDER=fake
# Groq. GRADING_MODEL must name a model from Groq's catalogue.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter, kept as an alternative. Selecting it means GRADING_MODEL takes a router-qualified
# identifier instead — the two settings always change together.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Only some Groq models accept a json_schema response format. One that does not is detected from
# its own 400 and graded with a prompt-constrained JSON contract instead, so this is a quality
# preference rather than a hard requirement.
GRADING_MODEL=openai/gpt-oss-120b
GRADING_TIMEOUT_SECONDS=45
# Immediate retries after a transient provider failure, before the scheduled sweep takes over.
GRADING_MAX_RETRIES=2
# How long an attempt must sit unresolved before the retry sweep claims it. Must exceed
# GRADING_TIMEOUT_SECONDS, or the sweep would grade an answer the submitting request is still
# grading, at double the cost.
GRADING_RETRY_AFTER_SECONDS=120
# Total grading calls one answer is worth before it is abandoned as failed. It is never scored.
GRADING_MAX_LIFETIME_RETRIES=5

# --- Billing -----------------------------------------------------------------------------
# Stripe is the only payment provider, and there is deliberately no fake counterpart to the fake
# grading provider: a fake grade is obviously local, but fake paid access would be
# indistinguishable from access that was bought. Develop against Stripe test-mode keys, which are
# free and produce real, verifiable events.
#
# Local webhook delivery: `stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe`
# prints the signing secret to put in STRIPE_WEBHOOK_SECRET. Without it the webhook endpoint
# refuses every request, which is the correct behaviour — an unverified event is not a payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_SEASON_PASS=
# How long a Season Pass grants access for, in days. Fixed at purchase, so a student knows
# exactly what they bought and nothing has to remember to expire it.
SEASON_PASS_DAYS=120

# --- Free tier ---------------------------------------------------------------------------
# The free tier proves the product works; it is not meant to be a usable product. The diagnostic
# is always graded in full and is never counted against the daily grading cap — a 24-question
# sitting would exhaust any sane cap on its own, and a half-graded diagnostic measures nothing.
FREE_PRACTICE_SESSIONS=3
FREE_DAILY_GRADED_ATTEMPTS=15

# --- Email -------------------------------------------------------------------------------
# 'log' writes each message to the application log and sends nothing. That is the default, so a
# fresh clone exercises the whole path — rendering, preference checks, delivery markers — without
# anything reaching a real inbox. Unlike payments, a fake here is safe: sending nothing grants
# nothing.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=LRN <no-reply@lrn.local>
EMAIL_REPLY_TO=
# Minimum gap between weak-area nudges for one student, enforced per recipient rather than by the
# job's schedule — so a re-run, a backfill or a second replica cannot double-send.
NUDGE_MIN_INTERVAL_DAYS=7
# A student with fewer graded answers than this has nothing worth being nudged about, and a
# reminder to "practise your weakest area" with no measured areas is spam.
NUDGE_MIN_GRADED_ATTEMPTS=3

# --- Analytics ---------------------------------------------------------------------------
# 'log' records events locally and makes no network call; 'none' switches analytics off entirely,
# which is a supported deployment. Events are fire-and-forget in every mode: analytics is an
# observation of the product, never a part of it.
ANALYTICS_PROVIDER=log
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
